<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="il.cshaifasweng.OCSFMediatorExample.client.GlobalSettingsController"
        stylesheets="@mycsss.css"
        fitToWidth="true"
        pannable="true"
        styleClass="app-scroll-container">
   <content>
      <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                  prefHeight="800.0" prefWidth="1200.0" styleClass="root"
                  xmlns="http://javafx.com/javafx/17"
                  xmlns:fx="http://javafx.com/fxml/1"
      >

         <!-- Navigation Bar -->
         <HBox alignment="CENTER_LEFT" layoutY="0.0" prefHeight="70.0" prefWidth="1200.0"
               spacing="20.0" styleClass="navbar" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
               <Insets left="20.0" right="20.0" />
            </padding>

            <Label text="FlowerShop Network" styleClass="navbar-brand">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

            <Label text="Global Settings" styleClass="navbar-title">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>

            <HBox HBox.hgrow="ALWAYS" />

            <Button fx:id="backButton" onAction="#handleBackToDashboard"
                    styleClass="btn-secondary" text="← Back to Dashboard">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </HBox>

         <!-- Main Content Area -->
         <ScrollPane fitToWidth="true" layoutY="70.0" prefHeight="730.0" prefWidth="1200.0"
                     AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                     AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <content>
               <VBox spacing="25.0" styleClass="content-container">
                  <padding>
                     <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                  </padding>

                  <!-- Page Header -->
                  <VBox spacing="10.0">
                     <Label text="Network-Wide Configuration" styleClass="page-title">
                        <font>
                           <Font name="System Bold" size="32.0" />
                        </font>
                     </Label>
                     <Label text="Manage global settings that apply to all branches"
                            styleClass="subtitle" textFill="#666666">
                        <font>
                           <Font size="16.0" />
                        </font>
                     </Label>
                  </VBox>

                  <!-- Company Information Card -->
                  <VBox spacing="20.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="Company Information" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <HBox spacing="30.0">
                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                           <VBox spacing="8.0">
                              <Label text="Company Name:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="companyNameField"
                                         styleClass="text-field">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>

                           <VBox spacing="8.0">
                              <Label text="Corporate Email:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="corporateEmailField"
                                         styleClass="text-field">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>
                        </VBox>

                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                           <VBox spacing="8.0">
                              <Label text="Corporate Phone:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="corporatePhoneField"
                                         styleClass="text-field">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>

                           <VBox spacing="8.0">
                              <Label text="Website:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="websiteField"
                                         styleClass="text-field">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>
                        </VBox>
                     </HBox>
                  </VBox>

                  <!-- Business Policies Card -->
                  <VBox spacing="20.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="Business Policies" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <HBox spacing="30.0">
                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                           <VBox spacing="8.0">
                              <Label text="Standard Delivery Fee (₪):" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="deliveryFeeField"
                                         styleClass="text-field" prefWidth="200.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>

                           <VBox spacing="8.0">
                              <Label text="Cancellation Full Refund Window (hours):" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="fullRefundWindowField"
                                         styleClass="text-field" prefWidth="200.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>

                           <VBox spacing="8.0">
                              <Label text="Partial Refund Percentage (%):" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="partialRefundPercentField"
                                         styleClass="text-field" prefWidth="200.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>
                        </VBox>

                        <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                           <VBox spacing="8.0">
                              <Label text="Subscription Discount (%):" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="subscriptionDiscountField"
                                         styleClass="text-field" prefWidth="200.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>

                           <VBox spacing="8.0">
                              <Label text="Complaint Response SLA (hours):" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="complaintSLAField"
                                         styleClass="text-field" prefWidth="200.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>

                           <VBox spacing="8.0">
                              <Label text="Loyalty Points Rate (points per ₪):" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="loyaltyPointsRateField"
                                         styleClass="text-field" prefWidth="200.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>
                        </VBox>
                     </HBox>
                  </VBox>

                  <!-- Feature Toggles Card -->
                  <VBox spacing="20.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="Feature Toggles" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <HBox spacing="50.0">
                        <VBox spacing="15.0">
                           <CheckBox fx:id="subscriptionFeatureCheckbox"
                                     text="Enable Subscription System" selected="true">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </CheckBox>
                           <CheckBox fx:id="loyaltyProgramCheckbox"
                                     text="Enable Loyalty Program" selected="true">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </CheckBox>
                           <CheckBox fx:id="customProductsCheckbox"
                                     text="Enable Custom Products" selected="true">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </CheckBox>
                           <CheckBox fx:id="giftWrappingCheckbox"
                                     text="Enable Gift Wrapping Option" selected="true">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </CheckBox>
                        </VBox>

                        <VBox spacing="15.0">
                           <CheckBox fx:id="greetingCardsCheckbox"
                                     text="Enable Greeting Cards" selected="true">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </CheckBox>
                           <CheckBox fx:id="emailNotificationsCheckbox"
                                     text="Enable Email Notifications" selected="true">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </CheckBox>
                           <CheckBox fx:id="smsNotificationsCheckbox"
                                     text="Enable SMS Notifications" selected="true">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </CheckBox>
                           <CheckBox fx:id="onlinePaymentCheckbox"
                                     text="Enable Online Payment" selected="true">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </CheckBox>
                        </VBox>
                     </HBox>
                  </VBox>

                  <!-- System Maintenance Card -->
                  <VBox spacing="20.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="System Maintenance" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <VBox spacing="15.0">
                        <CheckBox fx:id="maintenanceModeCheckbox"
                                  text="Enable Maintenance Mode (Disables all customer operations)">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </CheckBox>

                        <VBox spacing="8.0">
                           <Label text="Maintenance Message:" styleClass="field-label">
                              <font>
                                 <Font name="System Bold" size="14.0" />
                              </font>
                           </Label>
                           <TextField fx:id="maintenanceMessageField"
                                      promptText="Message to display during maintenance"
                                      styleClass="text-field">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </TextField>
                        </VBox>
                     </VBox>
                  </VBox>

                  <!-- Action Buttons -->
                  <HBox spacing="20.0" alignment="CENTER">
                     <padding>
                        <Insets top="10.0" />
                     </padding>

                     <Button fx:id="saveButton" onAction="#handleSaveSettings"
                             styleClass="btn-primary" prefWidth="250.0" prefHeight="50.0">
                        <graphic>
                           <Label text="💾 Save Global Settings">
                              <font>
                                 <Font name="System Bold" size="16.0" />
                              </font>
                           </Label>
                        </graphic>
                     </Button>

                     <Button fx:id="resetButton" onAction="#handleReset"
                             styleClass="btn-secondary" prefWidth="150.0">
                        <font>
                           <Font size="14.0" />
                        </font>
                        <graphic>
                           <Label text="Reset Changes">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                        </graphic>
                     </Button>
                  </HBox>

               </VBox>
            </content>
         </ScrollPane>

      </AnchorPane>
   </content>
</ScrollPane>