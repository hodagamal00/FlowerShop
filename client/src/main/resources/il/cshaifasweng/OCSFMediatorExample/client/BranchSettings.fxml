<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" 
            prefHeight="800.0" prefWidth="1200.0" styleClass="root" 
            stylesheets="@mycsss.css" xmlns="http://javafx.com/javafx/17" 
            xmlns:fx="http://javafx.com/fxml/1" 
            fx:controller="il.cshaifasweng.OCSFMediatorExample.client.BranchSettingsController">
   
   <!-- Navigation Bar -->
   <HBox alignment="CENTER_LEFT" layoutY="0.0" prefHeight="70.0" prefWidth="1200.0" 
         spacing="20.0" styleClass="navbar" AnchorPane.leftAnchor="0.0" 
         AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
      <padding>
         <Insets left="20.0" right="20.0" />
      </padding>
      
      <Label text="FlowerShop Manager" styleClass="navbar-brand">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      
      <Label text="Branch Settings" styleClass="navbar-title">
         <font>
            <Font name="System Bold" size="18.0" />
         </font>
      </Label>
      
      <HBox HBox.hgrow="ALWAYS" />
      
      <Button fx:id="backButton" onAction="#handleBackToCatalog" 
              styleClass="btn-secondary" text="← Back to Catalog">
         <font>
            <Font size="14.0" />
         </font>
      </Button>
   </HBox>
   
   <!-- Main Content Area -->
   <ScrollPane fitToWidth="true" layoutY="70.0" prefHeight="730.0" prefWidth="1200.0" 
               AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" 
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
      <content>
         <VBox spacing="25.0" styleClass="content-container">
            <padding>
               <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
            </padding>
            
            <!-- Page Header -->
            <VBox spacing="10.0">
               <Label text="Branch Configuration" styleClass="page-title">
                  <font>
                     <Font name="System Bold" size="32.0" />
                  </font>
               </Label>
               <Label text="Manage your branch settings and operational preferences" 
                      styleClass="subtitle" textFill="#666666">
                  <font>
                     <Font size="16.0" />
                  </font>
               </Label>
            </VBox>
            
            <!-- Branch Information Card -->
            <VBox spacing="20.0" styleClass="card">
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </padding>
               
               <Label text="Branch Information" styleClass="section-title">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               
               <Separator />
               
               <HBox spacing="30.0">
                  <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                     <!-- Branch Name -->
                     <VBox spacing="8.0">
                        <Label text="Branch Name:" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="branchNameField" promptText="e.g., Main Street Branch" 
                                   styleClass="text-field">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                     </VBox>
                     
                     <!-- Branch Address -->
                     <VBox spacing="8.0">
                        <Label text="Address:" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="addressField" promptText="Street address" 
                                   styleClass="text-field">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                     </VBox>
                     
                     <HBox spacing="15.0">
                        <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                           <Label text="City:" styleClass="field-label">
                              <font>
                                 <Font name="System Bold" size="14.0" />
                              </font>
                           </Label>
                           <TextField fx:id="cityField" promptText="City" 
                                      styleClass="text-field">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </TextField>
                        </VBox>
                        
                        <VBox spacing="8.0">
                           <Label text="Postal Code:" styleClass="field-label">
                              <font>
                                 <Font name="System Bold" size="14.0" />
                              </font>
                           </Label>
                           <TextField fx:id="postalCodeField" promptText="Postal code" 
                                      styleClass="text-field" prefWidth="150.0">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </TextField>
                        </VBox>
                     </HBox>
                  </VBox>
                  
                  <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                     <!-- Contact Phone -->
                     <VBox spacing="8.0">
                        <Label text="Contact Phone:" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="phoneField" promptText="e.g., +972-XX-XXXXXXX" 
                                   styleClass="text-field">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                     </VBox>
                     
                     <!-- Contact Email -->
                     <VBox spacing="8.0">
                        <Label text="Contact Email:" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="emailField" promptText="branch@flowershop.com" 
                                   styleClass="text-field">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                     </VBox>
                     
                     <!-- Branch Manager -->
                     <VBox spacing="8.0">
                        <Label text="Branch Manager:" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="managerField" promptText="Manager name" 
                                   styleClass="text-field">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                     </VBox>
                  </VBox>
               </HBox>
            </VBox>
            
            <!-- Operating Hours Card -->
            <VBox spacing="20.0" styleClass="card">
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </padding>
               
               <Label text="Operating Hours" styleClass="section-title">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               
               <Separator />
               
               <HBox spacing="40.0">
                  <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                     <Label text="Weekdays (Monday - Friday):" styleClass="field-label">
                        <font>
                           <Font name="System Bold" size="14.0" />
                        </font>
                     </Label>
                     <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <ComboBox fx:id="weekdayOpenCombo" promptText="Open" 
                                  prefWidth="120.0" styleClass="combo-box" />
                        <Label text="to" textFill="#666666">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="weekdayCloseCombo" promptText="Close" 
                                  prefWidth="120.0" styleClass="combo-box" />
                     </HBox>
                  </VBox>
                  
                  <VBox spacing="15.0" HBox.hgrow="ALWAYS">
                     <Label text="Weekends (Saturday - Sunday):" styleClass="field-label">
                        <font>
                           <Font name="System Bold" size="14.0" />
                        </font>
                     </Label>
                     <HBox spacing="10.0" alignment="CENTER_LEFT">
                        <ComboBox fx:id="weekendOpenCombo" promptText="Open" 
                                  prefWidth="120.0" styleClass="combo-box" />
                        <Label text="to" textFill="#666666">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Label>
                        <ComboBox fx:id="weekendCloseCombo" promptText="Close" 
                                  prefWidth="120.0" styleClass="combo-box" />
                     </HBox>
                  </VBox>
               </HBox>
               
               <CheckBox fx:id="closedWeekendsCheckbox" text="Closed on Weekends">
                  <font>
                     <Font size="14.0" />
                  </font>
               </CheckBox>
            </VBox>
            
            <!-- Delivery Settings Card -->
            <VBox spacing="20.0" styleClass="card">
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </padding>
               
               <Label text="Delivery Settings" styleClass="section-title">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               
               <Separator />
               
               <HBox spacing="30.0">
                  <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                     <!-- Delivery Fee -->
                     <VBox spacing="8.0">
                        <Label text="Standard Delivery Fee (₪):" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="deliveryFeeField" promptText="e.g., 15.00" 
                                   styleClass="text-field" prefWidth="200.0">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                     </VBox>
                     
                     <!-- Free Delivery Threshold -->
                     <VBox spacing="8.0">
                        <Label text="Free Delivery Threshold (₪):" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="freeDeliveryThresholdField" 
                                   promptText="e.g., 200.00" 
                                   styleClass="text-field" prefWidth="200.0">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                        <Label text="Orders above this amount get free delivery" 
                               textFill="#666666">
                           <font>
                              <Font size="12.0" />
                           </font>
                        </Label>
                     </VBox>
                  </VBox>
                  
                  <VBox spacing="20.0" HBox.hgrow="ALWAYS">
                     <!-- Max Delivery Distance -->
                     <VBox spacing="8.0">
                        <Label text="Maximum Delivery Distance (km):" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <TextField fx:id="maxDeliveryDistanceField" 
                                   promptText="e.g., 25" 
                                   styleClass="text-field" prefWidth="200.0">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </TextField>
                     </VBox>
                     
                     <!-- Delivery Options -->
                     <VBox spacing="12.0">
                        <Label text="Delivery Options:" styleClass="field-label">
                           <font>
                              <Font name="System Bold" size="14.0" />
                           </font>
                        </Label>
                        <CheckBox fx:id="sameDayDeliveryCheckbox" 
                                  text="Enable Same-Day Delivery" selected="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="scheduledDeliveryCheckbox" 
                                  text="Enable Scheduled Delivery" selected="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                     </VBox>
                  </VBox>
               </HBox>
            </VBox>
            
            <!-- Notification Settings Card -->
            <VBox spacing="20.0" styleClass="card">
               <padding>
                  <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
               </padding>
               
               <Label text="Notification Settings" styleClass="section-title">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Label>
               
               <Separator />
               
               <VBox spacing="15.0">
                  <Label text="Enable notifications for:" styleClass="field-label">
                     <font>
                        <Font name="System Bold" size="14.0" />
                     </font>
                  </Label>
                  
                  <HBox spacing="50.0">
                     <VBox spacing="12.0">
                        <CheckBox fx:id="newOrderNotifCheckbox" 
                                  text="New Orders" selected="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="orderStatusNotifCheckbox" 
                                  text="Order Status Changes" selected="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="lowStockNotifCheckbox" 
                                  text="Low Stock Alerts" selected="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                     </VBox>
                     
                     <VBox spacing="12.0">
                        <CheckBox fx:id="newComplaintNotifCheckbox" 
                                  text="New Complaints" selected="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="customerFeedbackNotifCheckbox" 
                                  text="Customer Feedback" selected="false">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                        <CheckBox fx:id="promotionNotifCheckbox" 
                                  text="Promotion Expiry Alerts" selected="true">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </CheckBox>
                     </VBox>
                  </HBox>
               </VBox>
            </VBox>
            
            <!-- Action Buttons -->
            <HBox spacing="20.0" alignment="CENTER">
               <padding>
                  <Insets top="10.0" />
               </padding>
               
               <Button fx:id="saveSettingsButton" onAction="#handleSaveSettings" 
                       styleClass="btn-primary" prefWidth="200.0">
                  <font>
                     <Font name="System Bold" size="16.0" />
                  </font>
                  <graphic>
                     <Label text="💾 Save All Settings">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                  </graphic>
               </Button>
               
               <Button fx:id="resetButton" onAction="#handleReset" 
                       styleClass="btn-secondary" prefWidth="150.0">
                  <font>
                     <Font size="14.0" />
                  </font>
                  <graphic>
                     <Label text="Reset to Default">
                        <font>
                           <Font size="14.0" />
                        </font>
                     </Label>
                  </graphic>
               </Button>
            </HBox>
            
         </VBox>
      </content>
   </ScrollPane>
   
</AnchorPane>
