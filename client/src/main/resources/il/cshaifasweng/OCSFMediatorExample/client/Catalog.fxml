<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<?import javafx.scene.control.Accordion?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<ScrollPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="il.cshaifasweng.OCSFMediatorExample.client.CatalogController"
        stylesheets="@mycsss.css"
        fitToWidth="true"
        pannable="true"
        styleClass="app-scroll-container">

    <content>
        <AnchorPane fx:id="es" maxHeight="800.0" maxWidth="1520.0" minHeight="780.0" minWidth="1520.0"
                    prefHeight="800.0" prefWidth="1520.0">

            <children>

                <!-- Left Sidebar - Cart Section -->
                <AnchorPane layoutX="0.0" layoutY="0.0" prefWidth="280.0" prefHeight="800.0"
                            styleClass="card"
                            style="-fx-background-color: white; -fx-border-color: #6a1b9a; -fx-border-width: 0 2 0 0;">
                    <children>
                        <Text fx:id="cartTopText" layoutX="20.0" layoutY="35.0" text="Shopping Cart" styleClass="card-header">
                            <font>
                                <Font name="System Bold" size="20.0"/>
                            </font>
                        </Text>

                        <ListView fx:id="CartItemsList" styleClass="list-view"
                                  layoutX="20.0" layoutY="50.0"
                                  prefHeight="450.0" prefWidth="240.0"/>

                        <VBox layoutX="20.0" layoutY="520.0" spacing="15.0" prefWidth="240.0">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <Text text="Subtotal:" strokeType="OUTSIDE">
                                            <font><Font size="14.0"/></font>
                                        </Text>
                                        <TextField fx:id="cartTextDiscount" editable="false" prefWidth="120.0"/>
                                    </children>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <Text text="Total:" strokeType="OUTSIDE">
                                            <font><Font name="System Bold" size="16.0"/></font>
                                        </Text>
                                        <TextField fx:id="cartTextPrice" editable="false" prefWidth="120.0"
                                                   style="-fx-font-weight: bold;"/>
                                    </children>
                                </HBox>

                                <Text fx:id="cartTextPriceDiscount" text="" fill="#6a1b9a">
                                    <font><Font size="12.0"/></font>
                                </Text>
                                <Text fx:id="cartTextPriceFinal" text="" fill="#4a148c">
                                    <font><Font name="System Bold" size="12.0"/></font>
                                </Text>

                                <Button fx:id="checkout" styleClass="btn-primary" mnemonicParsing="false"
                                        onAction="#openCheckout" prefHeight="45.0" prefWidth="240.0"
                                        text="Checkout"/>
                                <Button fx:id="viewCart" styleClass="btn-outline" mnemonicParsing="false"
                                        onAction="#viewUserCart" text="View Full Cart" prefWidth="240.0"/>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

                <!-- Main Content Area -->
                <AnchorPane layoutX="280.0" layoutY="0.0" prefWidth="1240.0" prefHeight="800.0"
                            style="-fx-background-color: #faf8fc;">
                    <children>

                        <!-- Filters -->
                        <HBox layoutX="20.0" layoutY="20.0" spacing="15.0" alignment="CENTER_LEFT">
                            <children>
                                <Label text="Filters:" styleClass="form-label"/>
                                <ComboBox fx:id="categoryFilter" styleClass="combo-box" promptText="Category" prefWidth="150.0"/>
                                <ComboBox fx:id="colorFilter" styleClass="combo-box" promptText="Color" prefWidth="130.0"/>
                                <ComboBox fx:id="priceFilter" styleClass="combo-box" promptText="Price Range" prefWidth="150.0"/>
                                <Button styleClass="btn-secondary" text="Clear Filters" onAction="#clearFilters" prefWidth="110.0"/>
                            </children>
                        </HBox>

                        <!-- Product Grid -->
                        <AnchorPane layoutX="20.0" layoutY="70.0" prefWidth="1000.0" prefHeight="600.0">
                            <children>

                                <!-- ===== Row 1 ===== -->
                                <VBox styleClass="product-card" fx:id="container1" alignment="TOP_CENTER"
                                      layoutX="0.0" layoutY="0.0"
                                      spacing="10.0" prefHeight="320.0" prefWidth="260.0" maxWidth="260.0">
                                    <children>
                                        <StackPane prefHeight="200.0">
                                            <children>
                                                <ImageView fx:id="flower_button1" fitHeight="180.0" fitWidth="220.0"
                                                           onMouseClicked="#product_clicked" pickOnBounds="true"
                                                           preserveRatio="true" styleClass="imgg">
                                                    <image><Image url="@../../../../images/flower2.jpg"/></image>
                                                </ImageView>

                                                <Label fx:id="flower_price1" text="150₪"
                                                       prefHeight="40.0" prefWidth="65.0"
                                                       style="-fx-border-color: black; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-font-size: 14px; -fx-font-weight: bold;">
                                                    <StackPane.margin>
                                                        <Insets top="10" right="10"/>
                                                    </StackPane.margin>
                                                    <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label fx:id="flower_name1" text="Sunflower" textFill="WHITE"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                        <Button styleClass="btn-primary" fx:id="flower1_addCart"
                                                mnemonicParsing="false" onAction="#addToCartFlower1"
                                                text="Add to Cart" prefWidth="220.0"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="product-card" fx:id="container2" alignment="TOP_CENTER"
                                      layoutX="340.0" layoutY="0.0"
                                      spacing="10.0" prefHeight="320.0" prefWidth="260.0" maxWidth="260.0">
                                    <children>
                                        <StackPane prefHeight="200.0">
                                            <children>
                                                <ImageView fx:id="flower_button2" fitHeight="180.0" fitWidth="220.0"
                                                           onMouseClicked="#product_clicked" pickOnBounds="true"
                                                           preserveRatio="true" styleClass="imgg">
                                                    <image><Image url="@../../../../images/flower1.jpg"/></image>
                                                </ImageView>

                                                <Label fx:id="flower_price2" text="100₪"
                                                       prefHeight="40.0" prefWidth="65.0"
                                                       style="-fx-border-color: black; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-font-size: 14px; -fx-font-weight: bold;">
                                                    <StackPane.margin>
                                                        <Insets top="10" right="10"/>
                                                    </StackPane.margin>
                                                    <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label fx:id="flower_name2" text="Daisy" textFill="WHITE"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                        <Button styleClass="btn-primary" fx:id="flower2_addCart"
                                                mnemonicParsing="false" onAction="#addToCartFlower2"
                                                text="Add to Cart" prefWidth="220.0"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="product-card" fx:id="container3" alignment="TOP_CENTER"
                                      layoutX="680.0" layoutY="0.0"
                                      spacing="10.0" prefHeight="320.0" prefWidth="260.0" maxWidth="260.0">
                                    <children>
                                        <StackPane prefHeight="200.0">
                                            <children>
                                                <ImageView fx:id="flower_button3" fitHeight="180.0" fitWidth="220.0"
                                                           onMouseClicked="#product_clicked" pickOnBounds="true"
                                                           preserveRatio="true" styleClass="imgg">
                                                    <image><Image url="@../../../../images/flower4.jpg"/></image>
                                                </ImageView>

                                                <Label fx:id="flower_price3" text="80₪"
                                                       prefHeight="40.0" prefWidth="65.0"
                                                       style="-fx-border-color: black; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-font-size: 14px; -fx-font-weight: bold;">
                                                    <StackPane.margin>
                                                        <Insets top="10" right="10"/>
                                                    </StackPane.margin>
                                                    <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label fx:id="flower_name3" text="Lily" textFill="WHITE"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                        <Button styleClass="btn-primary" fx:id="flower3_addCart"
                                                mnemonicParsing="false" onAction="#addToCartFlower3"
                                                text="Add to Cart" prefWidth="220.0"/>
                                    </children>
                                </VBox>

                                <!-- ===== Row 2 ===== -->
                                <VBox styleClass="product-card" fx:id="container4" alignment="TOP_CENTER"
                                      layoutX="0.0" layoutY="305.0"
                                      spacing="10.0" prefHeight="320.0" prefWidth="260.0" maxWidth="260.0">
                                    <children>
                                        <StackPane prefHeight="200.0">
                                            <children>
                                                <ImageView fx:id="flower_button4" fitHeight="180.0" fitWidth="220.0"
                                                           onMouseClicked="#product_clicked" pickOnBounds="true"
                                                           preserveRatio="true" styleClass="imgg">
                                                    <image><Image url="@../../../../images/flower3.jpg"/></image>
                                                </ImageView>

                                                <Label fx:id="flower_price4" text="60₪"
                                                       prefHeight="40.0" prefWidth="65.0"
                                                       style="-fx-border-color: black; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-font-size: 14px; -fx-font-weight: bold;">
                                                    <StackPane.margin>
                                                        <Insets top="10" right="10"/>
                                                    </StackPane.margin>
                                                    <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label fx:id="flower_name4" text="Tulip" textFill="WHITE"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                        <Button styleClass="btn-primary" fx:id="flower4_addCart"
                                                mnemonicParsing="false" onAction="#addToCartFlower4"
                                                text="Add to Cart" prefWidth="220.0"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="product-card" fx:id="container5" alignment="TOP_CENTER"
                                      layoutX="340.0" layoutY="305.0"
                                      spacing="10.0" prefHeight="320.0" prefWidth="260.0" maxWidth="260.0">
                                    <children>
                                        <StackPane prefHeight="200.0">
                                            <children>
                                                <ImageView fx:id="flower_button5" fitHeight="180.0" fitWidth="220.0"
                                                           onMouseClicked="#product_clicked" pickOnBounds="true"
                                                           preserveRatio="true" styleClass="imgg">
                                                    <image><Image url="@../../../../images/flower6.jpg"/></image>
                                                </ImageView>

                                                <Label fx:id="flower_price5" text="15₪"
                                                       prefHeight="40.0" prefWidth="65.0"
                                                       style="-fx-border-color: black; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-font-size: 14px; -fx-font-weight: bold;">
                                                    <StackPane.margin>
                                                        <Insets top="10" right="10"/>
                                                    </StackPane.margin>
                                                    <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label fx:id="flower_name5" text="Rose" textFill="WHITE"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                        <Button styleClass="btn-primary" fx:id="flower5_addCart"
                                                mnemonicParsing="false" onAction="#addToCartFlower5"
                                                text="Add to Cart" prefWidth="220.0"/>
                                    </children>
                                </VBox>

                                <VBox styleClass="product-card" fx:id="container6" alignment="TOP_CENTER"
                                      layoutX="680.0" layoutY="305.0"
                                      spacing="10.0" prefHeight="320.0" prefWidth="260.0" maxWidth="260.0">
                                    <children>
                                        <StackPane prefHeight="200.0">
                                            <children>
                                                <ImageView fx:id="flower_button6" fitHeight="180.0" fitWidth="220.0"
                                                           onMouseClicked="#product_clicked" pickOnBounds="true"
                                                           preserveRatio="true" styleClass="imgg">
                                                    <image><Image url="@../../../../images/flower5.jpg"/></image>
                                                </ImageView>

                                                <Label fx:id="flower_price6" text="120₪"
                                                       prefHeight="40.0" prefWidth="65.0"
                                                       style="-fx-border-color: black; -fx-background-radius: 5px; -fx-border-radius: 5px; -fx-font-size: 14px; -fx-font-weight: bold;">
                                                    <StackPane.margin>
                                                        <Insets top="10" right="10"/>
                                                    </StackPane.margin>
                                                    <StackPane.alignment>TOP_RIGHT</StackPane.alignment>
                                                </Label>
                                            </children>
                                        </StackPane>

                                        <Label fx:id="flower_name6" text="Orchid" textFill="WHITE"
                                               style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
                                        <Button styleClass="btn-primary" fx:id="flower6_addCart"
                                                mnemonicParsing="false" onAction="#addToCartFlower6"
                                                text="Add to Cart" prefWidth="220.0"/>
                                    </children>
                                </VBox>

                            </children>
                        </AnchorPane>

                        <!-- Pagination -->
                        <HBox layoutX="350.0" layoutY="690.0" spacing="20.0" alignment="CENTER">
                            <children>
                                <Button id="btttn" fx:id="prevPage" mnemonicParsing="false"
                                        onAction="#prevPageUpate" prefHeight="35.0" prefWidth="130.0"
                                        text="← Previous Page"/>
                                <Button id="btttn" fx:id="nextPage" mnemonicParsing="false"
                                        onAction="#nextPageUpate" prefHeight="35.0" prefWidth="130.0"
                                        text="Next Page →"/>
                            </children>
                        </HBox>

                    </children>
                </AnchorPane>


                <!-- Right Sidebar -->
                <AnchorPane id="menuu-content" layoutX="1320.0" layoutY="0.0"
                            prefHeight="800.0" prefWidth="200.0"
                            style="-fx-background-color: #f5f5f5; -fx-border-color: #ddd; -fx-border-width: 0 0 0 1;"
                            AnchorPane.rightAnchor="0.0">
                    <children>

                        <!-- Custom Item -->
                        <VBox layoutX="10.0" layoutY="20.0" spacing="12.0" prefWidth="180.0">
                            <children>
                                <Text text="Custom Order" strokeType="OUTSIDE" fill="#333">
                                    <font><Font name="System Bold" size="16.0"/></font>
                                </Text>
                                <Button fx:id="CreateCustomItem" mnemonicParsing="false"
                                        onAction="#createCustomitem" prefWidth="180.0" text="Create Custom Item"/>
                                <ComboBox fx:id="chooseCustomType" prefWidth="180.0" promptText="Item Type"/>
                                <ComboBox fx:id="chooseCustomColor" prefWidth="180.0" promptText="Color"/>
                                <TextField fx:id="customPrice" prefWidth="180.0" promptText="Price Range"/>
                                <Button id="btttn" fx:id="FinishCustomItem" mnemonicParsing="false"
                                        onAction="#addCartCustomitem" prefWidth="180.0" text="Add to Cart"/>
                                <Button id="btttn" fx:id="CancelCustomItem" mnemonicParsing="false"
                                        onAction="#cancelCustomitem" prefWidth="180.0" text="Cancel"/>
                                <Text fx:id="customError" fill="RED" wrappingWidth="180.0"/>
                            </children>
                        </VBox>

                        <!-- Admin Catalog -->
                        <VBox layoutX="10.0" layoutY="350.0" spacing="10.0" prefWidth="180.0">
                            <children>
                                <Text text="Admin Catalog" strokeType="OUTSIDE" fill="#333">
                                    <font><Font name="System Bold" size="14.0"/></font>
                                </Text>
                                <ComboBox id="btttn" fx:id="adminEditCatalog" onAction="#chooseAdminEditCatalog"
                                          prefWidth="180.0" promptText="Select Product"/>
                                <TextField fx:id="EditItemType" prefWidth="180.0" promptText="Item Type"/>
                                <TextField fx:id="EditItemDesc" prefWidth="180.0" promptText="Description"/>
                                <TextField fx:id="EditItemPrice" prefWidth="180.0" promptText="Price"/>
                                <TextField fx:id="EditItemExtra" prefWidth="180.0" promptText="Extra Info"/>
                                <Button id="btttn" fx:id="AddItem" mnemonicParsing="false"
                                        onAction="#adminAddItemFunc" prefWidth="180.0" text="Add Product"/>
                                <Button id="btttn" fx:id="UpdateItem" mnemonicParsing="false"
                                        onAction="#adminUpdateItemFunc" prefWidth="180.0" text="Update Product"/>
                                <Button id="btttn" fx:id="RemoveItem" mnemonicParsing="false"
                                        onAction="#adminRemoveItemFunc" prefWidth="180.0" text="Remove Product"/>
                            </children>
                        </VBox>

                        <!-- Account & Tools -->
                        <VBox layoutX="10.0" layoutY="600.0" spacing="8.0" prefWidth="180.0">
                            <children>
                                <Text text="Account & Tools" strokeType="OUTSIDE" fill="#333">
                                    <font><Font name="System Bold" size="14.0"/></font>
                                </Text>
                                <Button fx:id="viewMyOrders" mnemonicParsing="false"
                                        onAction="#openMyOrders" prefWidth="180.0" text="My Orders"/>
                                <Button fx:id="viewMyComplaints" mnemonicParsing="false"
                                        onAction="#openMyComplaints" prefWidth="180.0" text="My Complaints"/>
                                <Button fx:id="viewInboxPlz" mnemonicParsing="false"
                                        onAction="#openInbox" prefWidth="180.0" text="Inbox"/>
                                <Button fx:id="openComplaints" mnemonicParsing="false"
                                        onAction="#ReplyToComplaints" prefWidth="180.0" text="Handle Complaints"/>
                                <Button fx:id="deliveryButton" mnemonicParsing="false"
                                        onAction="#openDelivery" prefWidth="180.0" text="Deliveries"/>
                                <Button fx:id="adminControlButtton" mnemonicParsing="false"
                                        onAction="#openControlPanel" prefWidth="180.0" text="Admin Control"/>
                                <Button fx:id="infoo" mnemonicParsing="false"
                                        onAction="#openComplaintManager" prefWidth="180.0" text="Manager Reports"/>
                                <Button fx:id="logout" mnemonicParsing="false"
                                        onAction="#goLogOut" prefWidth="180.0" text="Logout"/>
                            </children>
                        </VBox>

                    </children>
                </AnchorPane>


                <!-- Initialization Dialog -->
                <AnchorPane id="ee" fx:id="init_container" layoutX="510.0" layoutY="300.0"
                            prefHeight="200.0" prefWidth="500.0">
                    <children>
                        <VBox alignment="CENTER" spacing="20.0" layoutX="100.0" layoutY="50.0" prefWidth="300.0">
                            <children>
                                <Text fx:id="justText" text="Welcome to FlowerShop!" textAlignment="CENTER" fill="#666">
                                    <font><Font name="Comic Sans MS" size="18.0"/></font>
                                </Text>
                                <Button fx:id="justButton" mnemonicParsing="false" onAction="#justView"
                                        prefHeight="40.0" prefWidth="200.0" text="Continue"/>
                            </children>
                        </VBox>
                    </children>
                </AnchorPane>

                <!-- Hidden Elements -->
                <TextField fx:id="customid" layoutX="-100.0" layoutY="-100.0" visible="false"/>
                <Button fx:id="printProd" layoutX="-100.0" layoutY="-100.0" visible="false"
                        mnemonicParsing="false" onAction="#printProducts" text="Print"/>
                <Button fx:id="accbtn" layoutX="-100.0" layoutY="-100.0" visible="false"
                        mnemonicParsing="false" onAction="#accbtnlogin" text="Account"/>
                <Button fx:id="compln" layoutX="-100.0" layoutY="-100.0" visible="false"
                        mnemonicParsing="false" onAction="#complinstart" text="Complaint"/>
                <ComboBox fx:id="worker_edit" layoutX="-100.0" layoutY="-100.0" visible="false"
                          onAction="#chooseAdminEditCatalog" promptText="Workers"/>
                <ListView fx:id="inboxList" layoutX="-100.0" layoutY="-100.0" visible="false"
                          prefHeight="0.0" prefWidth="0.0"/>
                <Button fx:id="openMessage" layoutX="-100.0" layoutY="-100.0" visible="false"
                        mnemonicParsing="false" onAction="#viewMessage" text="Message"/>
                <TextField fx:id="messageField" layoutX="-100.0" layoutY="-100.0" visible="false"/>

            </children>
        </AnchorPane>
    </content>
</ScrollPane>
