<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    AppShell.fxml defines a reusable application shell using a BorderPane.
    The top region contains a header bar with the logo, search box,
    login/profile buttons and cart badge.  The center region is a StackPane
    (`contentPane`) that will host different views (catalog, checkout, etc.)
    loaded via NavigationService.  The bottom region displays a simple
    status bar for application messages.
-->

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="il.cshaifasweng.OCSFMediatorExample.client.AppShellController"
            stylesheets="@styles.css" styleClass="app-shell">
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <HBox fx:id="header" styleClass="header-bar" alignment="CENTER_LEFT" spacing="14.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="Lilach" styleClass="brand-title" />
                    <Label text="Flower Shop" styleClass="brand-tagline" />
                </HBox>
                <TextField fx:id="searchField" promptText="Search bouquets or gifts" maxWidth="340.0" styleClass="text-field" HBox.hgrow="ALWAYS" />
                <HBox spacing="10.0" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <VBox fx:id="profileContainer" alignment="CENTER_RIGHT" spacing="4.0" visible="false" managed="false">
                        <Label fx:id="profileNameLabel" styleClass="profile-label" />
                        <Button fx:id="profileButton" text="Profile" styleClass="btn-secondary" />
                    </VBox>
                    <Button fx:id="loginButton" text="Login" styleClass="btn-primary" />
                    <Button fx:id="cartButton" text="Cart (0)" styleClass="btn-secondary" />
                </HBox>
            </HBox>
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Browse" styleClass="nav-section-title" />
            </HBox>
        </VBox>
    </top>
    <left>
        <VBox styleClass="side-nav" spacing="12.0" prefWidth="200.0" BorderPane.alignment="CENTER_LEFT">
            <FlowPane fx:id="navBar" hgap="8.0" vgap="10.0" prefWrapLength="180.0" orientation="VERTICAL" styleClass="nav-bar" />
        </VBox>
    </left>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area" />
    </center>
    <bottom>
        <HBox fx:id="statusBar" spacing="6.0" alignment="CENTER_LEFT" BorderPane.alignment="CENTER" styleClass="status-bar">
            <Label fx:id="statusLabel" text="Ready" />
        </HBox>
    </bottom>
</BorderPane>