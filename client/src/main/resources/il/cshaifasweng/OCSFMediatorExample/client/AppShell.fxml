<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!--
    AppShell.fxml defines a reusable application shell using a BorderPane.
    The top region contains a header bar with the logo, search box,
    login/profile buttons and cart badge.  The center region is a StackPane
    (`contentPane`) that will host different views (catalog, checkout, etc.)
    loaded via NavigationService.  The bottom region displays a simple
    status bar for application messages.
-->

<BorderPane fx:id="root" xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="il.cshaifasweng.OCSFMediatorExample.client.AppShellController"
            stylesheets="@styles.css">
    <top>
        <VBox spacing="6.0" BorderPane.alignment="CENTER">
            <HBox fx:id="header" styleClass="navbar" alignment="CENTER_LEFT" spacing="10.0">
                <Label text="LILACH" styleClass="header-title" />
                <TextField fx:id="searchField" promptText="Search..." maxWidth="300.0" styleClass="text-field" />
                <HBox spacing="5.0" alignment="CENTER_RIGHT" HBox.hgrow="ALWAYS">
                    <Button fx:id="loginButton" text="Login" styleClass="btn-primary" />
                    <Button fx:id="profileButton" text="Profile" visible="false" styleClass="btn-primary" />
                    <Button fx:id="cartButton" text="Cart (0)" styleClass="btn-secondary" />
                </HBox>
            </HBox>
            <FlowPane fx:id="navBar" hgap="8.0" vgap="6.0" styleClass="nav-bar" />
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contentPane" />
    </center>
    <bottom>
        <HBox fx:id="statusBar" spacing="5.0" alignment="CENTER_LEFT" BorderPane.alignment="CENTER">
            <Label fx:id="statusLabel" text="Ready" />
        </HBox>
    </bottom>
</BorderPane>