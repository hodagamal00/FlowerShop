<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    AppShell.fxml defines a reusable application shell using a BorderPane.
    The top region contains a header bar with the logo, search box,
    login/profile buttons and cart badge.  The center region is a StackPane
    (`contentPane`) that will host different views (catalog, checkout, etc.)
    loaded via NavigationService.  The bottom region displays a simple
    status bar for application messages.
-->

<BorderPane fx:id="root" styleClass="app-shell" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.AppShellController">
    <top>
        <VBox spacing="8.0" BorderPane.alignment="CENTER">
            <HBox fx:id="header" alignment="CENTER_LEFT" spacing="14.0" styleClass="header-bar">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="brand-title" text="Lilach" />
                    <Label styleClass="brand-tagline" text="Flower Shop" />
                </HBox>
                <TextField fx:id="searchField" maxWidth="320.0" prefWidth="260.0" promptText="Search bouquets or gifts" styleClass="text-field" />
                <FlowPane fx:id="navBar" hgap="8.0" orientation="HORIZONTAL" styleClass="nav-bar top-nav" vgap="10.0" HBox.hgrow="ALWAYS" />
                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                    <VBox fx:id="profileContainer" alignment="CENTER_RIGHT" managed="false" spacing="4.0" visible="false">
                        <Label fx:id="profileNameLabel" styleClass="profile-label" />
                        <Button fx:id="profileButton" styleClass="btn-secondary" text="Profile" />
                    </VBox>
                    <Button fx:id="loginButton" styleClass="btn-primary" text="Login" />
                    <Button fx:id="cartButton" styleClass="btn-secondary" text="Cart (0)" />
                </HBox>
            </HBox>
        </VBox>
    </top>
    <center>
        <StackPane fx:id="contentPane" styleClass="content-area" />
    </center>
</BorderPane>
