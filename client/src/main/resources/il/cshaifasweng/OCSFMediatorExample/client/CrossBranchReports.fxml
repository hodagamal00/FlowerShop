<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="il.cshaifasweng.OCSFMediatorExample.client.CrossBranchReportsController"
        stylesheets="@styles.css"
        fitToWidth="true"
        pannable="true"
        styleClass="app-scroll-container">
   <content>
      <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                  prefHeight="800.0" prefWidth="1200.0" styleClass="root"
                  xmlns="http://javafx.com/javafx/17"
                  xmlns:fx="http://javafx.com/fxml/1"
      >

         <!-- Navigation Bar -->
         <HBox alignment="CENTER_LEFT" layoutY="0.0" prefHeight="70.0" prefWidth="1200.0"
               spacing="20.0" styleClass="navbar" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
               <Insets left="20.0" right="20.0" />
            </padding>

            <Label text="FlowerShop Network" styleClass="navbar-brand">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

            <Label text="Cross-Branch Reports" styleClass="navbar-title">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>

            <HBox HBox.hgrow="ALWAYS" />

            <Button fx:id="backButton" onAction="#handleBackToDashboard"
                    styleClass="btn-secondary" text="← Back to Dashboard">
               <font>
                  <Font size="14.0" />
               </font>
            </Button>
         </HBox>

         <!-- Main Content Area -->
         <ScrollPane fitToWidth="true" layoutY="70.0" prefHeight="730.0" prefWidth="1200.0"
                     AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                     AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <content>
               <VBox spacing="25.0" styleClass="content-container">
                  <padding>
                     <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                  </padding>

                  <!-- Page Header -->
                  <VBox spacing="10.0">
                     <Label text="Network-Wide Analytics" styleClass="page-title">
                        <font>
                           <Font name="System Bold" size="32.0" />
                        </font>
                     </Label>
                     <Label text="Compare and analyze performance across all branches"
                            styleClass="subtitle" textFill="#666666">
                        <font>
                           <Font size="16.0" />
                        </font>
                     </Label>
                  </VBox>

                  <!-- Report Filters -->
                  <VBox spacing="15.0" styleClass="card">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>

                     <Label text="Report Configuration" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="18.0" />
                        </font>
                     </Label>

                     <HBox spacing="20.0" alignment="CENTER_LEFT">
                        <VBox spacing="8.0">
                           <Label text="Date Range:" styleClass="field-label">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <HBox spacing="10.0" alignment="CENTER_LEFT">
                              <DatePicker fx:id="startDatePicker" prefWidth="150.0"
                                          styleClass="date-picker" />
                              <Label text="to" textFill="#666666" />
                              <DatePicker fx:id="endDatePicker" prefWidth="150.0"
                                          styleClass="date-picker" />
                           </HBox>
                        </VBox>

                        <VBox spacing="8.0">
                           <Label text="Branches:" styleClass="field-label">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <HBox spacing="10.0" alignment="CENTER_LEFT">
                              <CheckBox fx:id="selectAllBranchesCheckbox" text="Select All"
                                        selected="true" onAction="#handleSelectAllBranches">
                                 <font>
                                    <Font size="13.0" />
                                 </font>
                              </CheckBox>
                           </HBox>
                        </VBox>

                        <VBox spacing="8.0" alignment="BOTTOM_LEFT">
                           <Label text=" " />
                           <HBox spacing="10.0">
                              <Button fx:id="generateButton" onAction="#handleGenerateReport"
                                      styleClass="btn-primary" text="Generate Report">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Button>
                              <Button fx:id="exportButton" onAction="#handleExportReport"
                                      styleClass="btn-secondary" text="Export PDF">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                           </HBox>
                        </VBox>
                     </HBox>
                  </VBox>

                  <!-- Revenue Comparison Chart -->
                  <VBox spacing="15.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="Revenue Comparison" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <!-- Bar Chart for Revenue Comparison -->
                     <BarChart fx:id="revenueComparisonChart" prefHeight="400.0"
                               legendVisible="true" title="Branch Revenue Comparison">
                        <xAxis>
                           <CategoryAxis fx:id="revenueBranchAxis" label="Branch" />
                        </xAxis>
                        <yAxis>
                           <NumberAxis fx:id="revenueAxis" label="Revenue (₪)" />
                        </yAxis>
                     </BarChart>

                     <!-- Revenue Table -->
                     <TableView fx:id="revenueTable" prefHeight="200.0">
                        <columns>
                           <TableColumn fx:id="revenueBranchCol" prefWidth="200.0" text="Branch" />
                           <TableColumn fx:id="revenueOrdersCol" prefWidth="150.0" text="Total Orders" />
                           <TableColumn fx:id="revenueAmountCol" prefWidth="150.0" text="Total Revenue" />
                           <TableColumn fx:id="revenueAvgCol" prefWidth="150.0" text="Avg Order Value" />
                           <TableColumn fx:id="revenueGrowthCol" prefWidth="150.0" text="Growth %" />
                        </columns>
                     </TableView>
                  </VBox>

                  <!-- Order Trends Chart -->
                  <VBox spacing="15.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="Order Trends Over Time" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <!-- Line Chart for Order Trends -->
                     <LineChart fx:id="orderTrendsChart" prefHeight="400.0"
                                legendVisible="true" title="Orders by Branch Over Time">
                        <xAxis>
                           <CategoryAxis fx:id="trendTimeAxis" label="Time Period" />
                        </xAxis>
                        <yAxis>
                           <NumberAxis fx:id="trendOrdersAxis" label="Number of Orders" />
                        </yAxis>
                     </LineChart>
                  </VBox>

                  <!-- Market Share Analysis -->
                  <VBox spacing="15.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="Market Share Distribution" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <HBox spacing="30.0">
                        <!-- Pie Chart for Revenue Share -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                           <Label text="Revenue Share" styleClass="field-label">
                              <font>
                                 <Font name="System Bold" size="16.0" />
                              </font>
                           </Label>
                           <PieChart fx:id="revenueSharePieChart" prefHeight="350.0"
                                     legendVisible="true" />
                        </VBox>

                        <!-- Pie Chart for Order Share -->
                        <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                           <Label text="Order Volume Share" styleClass="field-label">
                              <font>
                                 <Font name="System Bold" size="16.0" />
                              </font>
                           </Label>
                           <PieChart fx:id="orderSharePieChart" prefHeight="350.0"
                                     legendVisible="true" />
                        </VBox>
                     </HBox>
                  </VBox>

                  <!-- Performance Metrics -->
                  <VBox spacing="15.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="Key Performance Indicators" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <HBox spacing="30.0" alignment="CENTER">
                        <VBox spacing="8.0" alignment="CENTER" styleClass="stat-box">
                           <padding>
                              <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                           </padding>
                           <Label text="Best Performer" styleClass="stat-label">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label fx:id="bestPerformerLabel" text="N/A" styleClass="stat-value"
                                  textFill="#4caf50">
                              <font>
                                 <Font name="System Bold" size="20.0" />
                              </font>
                           </Label>
                        </VBox>

                        <VBox spacing="8.0" alignment="CENTER" styleClass="stat-box">
                           <padding>
                              <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                           </padding>
                           <Label text="Network Avg Revenue" styleClass="stat-label">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label fx:id="avgRevenueLabel" text="₪0.00" styleClass="stat-value"
                                  textFill="#ba68c8">
                              <font>
                                 <Font name="System Bold" size="20.0" />
                              </font>
                           </Label>
                        </VBox>

                        <VBox spacing="8.0" alignment="CENTER" styleClass="stat-box">
                           <padding>
                              <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
                           </padding>
                           <Label text="Network Growth" styleClass="stat-label">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label fx:id="networkGrowthLabel" text="0%" styleClass="stat-value"
                                  textFill="#2196f3">
                              <font>
                                 <Font name="System Bold" size="20.0" />
                              </font>
                           </Label>
                        </VBox>
                     </HBox>
                  </VBox>

               </VBox>
            </content>
         </ScrollPane>

      </AnchorPane>
   </content>
</ScrollPane>