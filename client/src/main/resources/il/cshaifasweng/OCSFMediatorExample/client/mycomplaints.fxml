<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="780.0" prefHeight="800.0" prefWidth="1600.0" stylesheets="@styles.css" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="il.cshaifasweng.OCSFMediatorExample.client.MyComplaintsController">
   <children>
      <!-- Header -->
      <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="80.0" prefWidth="1600.0" style="-fx-background-color: #2c3e50;" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <children>
            <BorderPane prefHeight="80.0" prefWidth="1600.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
               <left>
                  <Label text="My Complaints" textFill="WHITE" BorderPane.alignment="CENTER_LEFT">
                     <font>
                        <Font name="System Bold" size="28.0" />
                     </font>
                  </Label>
               </left>
               <padding>
                  <Insets bottom="0.0" left="20.0" right="20.0" top="0.0" />
               </padding>
            </BorderPane>
         </children>
      </AnchorPane>

      <!-- Left Panel - Complaints List -->
      <AnchorPane layoutX="20.0" layoutY="100.0" prefHeight="680.0" prefWidth="350.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 1; -fx-border-radius: 5;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="20.0" AnchorPane.topAnchor="100.0">
         <children>
            <VBox layoutX="15.0" layoutY="15.0" prefWidth="320.0" spacing="15.0">
               <Text fill="#2c3e50" strokeType="OUTSIDE" text="Your Complaint History">
                  <font>
                     <Font name="System Bold" size="20.0" />
                  </font>
               </Text>
               <Button fx:id="loadButton" mnemonicParsing="false" onAction="#loadComplaints" prefHeight="40.0" prefWidth="320.0" style="-fx-font-size: 14px; -fx-font-weight: bold;" text="Refresh Complaint List" />
               <ListView fx:id="complaintList" prefHeight="580.0" prefWidth="320.0" />
            </VBox>
         </children>
      </AnchorPane>

      <!-- Right Panel - Complaint Details -->
      <AnchorPane layoutX="387.0" layoutY="120.0" prefHeight="680.0" prefWidth="1110.0" style="-fx-background-color: white; -fx-border-color: #ddd; -fx-border-width: 1; -fx-border-radius: 5;" AnchorPane.bottomAnchor="20.0" AnchorPane.leftAnchor="387.0" AnchorPane.rightAnchor="20.0" AnchorPane.topAnchor="120.0">
         <children>
            <!-- Complaint Details Section -->
            <VBox layoutX="30.0" layoutY="20.0" prefWidth="1050.0" spacing="16.0">
               <Text fill="#2c3e50" text="Complaint Details">
                  <font>
                     <Font name="System Bold" size="22.0" />
                  </font>
               </Text>

               <VBox spacing="8.0">
                  <Text strokeType="OUTSIDE" text="Complaint Date &amp; Time:"><font><Font size="14.0" /></font></Text>
                  <TextField fx:id="complaintDateTime" editable="false" prefWidth="520.0" style="-fx-background-color: #f0f0f0;" />
               </VBox>

               <VBox spacing="8.0">
                  <Text fill="#2c3e50" text="Complaint Description">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Text>
                  <TextArea fx:id="complaintText" prefHeight="180.0" prefWidth="520.0" promptText="Enter your complaint here..." wrapText="true" />
               </VBox>

               <VBox spacing="8.0">
                  <Text strokeType="OUTSIDE" text="Response Status:"><font><Font size="14.0" /></font></Text>
                  <TextField fx:id="answerBool" editable="false" prefWidth="520.0" style="-fx-background-color: #f0f0f0;" />
               </VBox>

               <VBox spacing="8.0">
                  <Text text="Responded At:" strokeType="OUTSIDE"><font><Font size="14.0" /></font></Text>
                  <TextField fx:id="respondedAt" editable="false" prefWidth="520.0" style="-fx-background-color: #f0f0f0;" />
               </VBox>

               <VBox spacing="8.0">
                  <Text text="Compensation Decision:" strokeType="OUTSIDE"><font><Font size="14.0" /></font></Text>
                  <TextField fx:id="compensationDecision" editable="false" prefWidth="520.0" style="-fx-background-color: #f0f0f0;" />
               </VBox>

               <VBox spacing="8.0">
                  <Text text="Compensation Amount:" strokeType="OUTSIDE"><font><Font size="14.0" /></font></Text>
                  <TextField fx:id="refundMoney" editable="false" prefWidth="520.0" style="-fx-background-color: #f0f0f0; -fx-font-size: 16px; -fx-font-weight: bold;" />
               </VBox>

               <VBox spacing="8.0">
                  <Text fill="#2c3e50" text="Worker Response">
                     <font>
                        <Font name="System Bold" size="18.0" />
                     </font>
                  </Text>
                  <TextArea fx:id="responseText" editable="false" prefHeight="160.0" prefWidth="520.0" style="-fx-background-color: #f0f0f0;" wrapText="true" />
               </VBox>

               <Button fx:id="submitComplaint" mnemonicParsing="false" onAction="#submitComplaint" prefHeight="40.0" prefWidth="200.0" style="-fx-background-color: #9b59b6; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold;" text="Submit Complaint" />
            </VBox>


         </children>
      </AnchorPane>
   </children>
</AnchorPane>
