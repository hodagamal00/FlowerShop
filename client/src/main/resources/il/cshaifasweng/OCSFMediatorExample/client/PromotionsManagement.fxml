<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<ScrollPane
        xmlns="http://javafx.com/javafx/17"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="il.cshaifasweng.OCSFMediatorExample.client.PromotionsManagementController"
        stylesheets="@styles.css"
        fitToWidth="true"
        pannable="true"
        styleClass="app-scroll-container">
   <content>
      <AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity"
                  prefHeight="800.0" prefWidth="1200.0" styleClass="root"
                  xmlns="http://javafx.com/javafx/17"
                  xmlns:fx="http://javafx.com/fxml/1"
      >

         <!-- Navigation Bar -->
         <HBox alignment="CENTER_LEFT" layoutY="0.0" prefHeight="70.0" prefWidth="1200.0"
               spacing="20.0" styleClass="navbar" AnchorPane.leftAnchor="0.0"
               AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
            <padding>
               <Insets left="20.0" right="20.0" />
            </padding>

            <Label text="FlowerShop Manager" styleClass="navbar-brand">
               <font>
                  <Font name="System Bold" size="24.0" />
               </font>
            </Label>

            <Label text="Promotions Management" styleClass="navbar-title">
               <font>
                  <Font name="System Bold" size="18.0" />
               </font>
            </Label>

            <HBox HBox.hgrow="ALWAYS" />

         </HBox>

         <!-- Main Content Area -->
         <ScrollPane fitToWidth="true" layoutY="70.0" prefHeight="730.0" prefWidth="1200.0"
                     AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0"
                     AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="70.0">
            <content>
               <VBox spacing="25.0" styleClass="content-container">
                  <padding>
                     <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
                  </padding>

                  <!-- Page Header -->
                  <VBox spacing="10.0">
                     <Label text="Branch Promotions &amp; Sales" styleClass="page-title">
                        <font>
                           <Font name="System Bold" size="32.0" />
                        </font>
                     </Label>
                     <Label text="Create and manage promotional campaigns for your branch"
                            styleClass="subtitle" textFill="#666666">
                        <font>
                           <Font size="16.0" />
                        </font>
                     </Label>
                  </VBox>

                  <!-- Create/Edit Promotion Card -->
                  <VBox spacing="20.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label fx:id="formTitleLabel" text="Create New Promotion" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <!-- Promotion Details Form -->
                     <HBox spacing="20.0">
                        <VBox spacing="30.0" HBox.hgrow="ALWAYS">
                           <!-- Promotion Name -->
                           <VBox spacing="8.0">
                              <Label text="Promotion Name:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <TextField fx:id="promotionNameField" promptText="e.g., Spring Sale 2025"
                                         styleClass="text-field" prefWidth="400.0">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </TextField>
                           </VBox>

                           <!-- Discount Percentage -->
                           <VBox spacing="8.0">
                              <Label text="Discount Percentage:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <HBox spacing="10.0" alignment="CENTER_LEFT">
                                 <TextField fx:id="discountField" promptText="Enter discount %"
                                            styleClass="text-field" prefWidth="150.0">
                                    <font>
                                       <Font size="14.0" />
                                    </font>
                                 </TextField>
                                 <Label text="%" textFill="#666666">
                                    <font>
                                       <Font size="16.0" />
                                    </font>
                                 </Label>
                              </HBox>
                           </VBox>

                           <!-- Date Range -->
                           <VBox spacing="8.0">
                              <Label text="Promotion Period:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <HBox spacing="15.0" alignment="CENTER_LEFT">
                                 <VBox spacing="5.0">
                                    <Label text="Start Date:" textFill="#666666">
                                       <font>
                                          <Font size="12.0" />
                                       </font>
                                    </Label>
                                    <DatePicker fx:id="startDatePicker" prefWidth="180.0"
                                                styleClass="date-picker" />
                                 </VBox>
                                 <VBox spacing="5.0">
                                    <Label text="End Date:" textFill="#666666">
                                       <font>
                                          <Font size="12.0" />
                                       </font>
                                    </Label>
                                    <DatePicker fx:id="endDatePicker" prefWidth="180.0"
                                                styleClass="date-picker" />
                                 </VBox>
                              </HBox>
                           </VBox>
                        </VBox>

                        <VBox spacing="30.0" HBox.hgrow="ALWAYS">
                           <!-- Product Selection -->
                           <VBox spacing="8.0">
                              <Label text="Apply To:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <ComboBox fx:id="applyToCombo" prefWidth="300.0"
                                        promptText="Select products or category" styleClass="combo-box">
                              </ComboBox>
                           </VBox>

                           <!-- Status -->
                           <VBox spacing="8.0">
                              <Label text="Status:" styleClass="field-label">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Label>
                              <CheckBox fx:id="activeCheckbox" text="Active" selected="true">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </CheckBox>
                           </VBox>

                           <!-- Action Buttons -->
                           <HBox spacing="15.0" alignment="CENTER_LEFT">
                              <VBox.margin>
                                 <Insets top="20.0" />
                              </VBox.margin>
                              <Button fx:id="savePromotionButton" onAction="#handleSavePromotion"
                                      styleClass="btn-primary" text="Save Promotion">
                                 <font>
                                    <Font name="System Bold" size="14.0" />
                                 </font>
                              </Button>
                              <Button fx:id="clearFormButton" onAction="#handleClearForm"
                                      styleClass="btn-secondary" text="Clear Form">
                                 <font>
                                    <Font size="14.0" />
                                 </font>
                              </Button>
                           </HBox>
                        </VBox>
                     </HBox>
                  </VBox>

                  <!-- Active Promotions Table -->
                  <VBox spacing="15.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <HBox alignment="CENTER_LEFT" spacing="15.0">
                        <Label text="Active Promotions" styleClass="section-title">
                           <font>
                              <Font name="System Bold" size="20.0" />
                           </font>
                        </Label>
                        <HBox HBox.hgrow="ALWAYS" />
                        <Button fx:id="refreshButton" onAction="#handleRefresh"
                                styleClass="btn-secondary" text="🔄 Refresh">
                           <font>
                              <Font size="14.0" />
                           </font>
                        </Button>
                     </HBox>

                     <Separator />

                     <TableView fx:id="promotionsTable" prefHeight="300.0">
                        <columns>
                           <TableColumn fx:id="promotionIdCol" prefWidth="80.0" text="ID" />
                           <TableColumn fx:id="promotionNameCol" prefWidth="250.0" text="Promotion Name" />
                           <TableColumn fx:id="discountCol" prefWidth="120.0" text="Discount %" />
                           <TableColumn fx:id="startDateCol" prefWidth="150.0" text="Start Date" />
                           <TableColumn fx:id="endDateCol" prefWidth="150.0" text="End Date" />
                           <TableColumn fx:id="applyToCol" prefWidth="200.0" text="Applies To" />
                           <TableColumn fx:id="statusCol" prefWidth="100.0" text="Status" />
                           <TableColumn fx:id="actionsCol" prefWidth="150.0" text="Actions" />
                        </columns>
                     </TableView>
                  </VBox>

                  <!-- Promotion Statistics -->
                  <VBox spacing="15.0" styleClass="card">
                     <padding>
                        <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
                     </padding>

                     <Label text="Promotion Statistics" styleClass="section-title">
                        <font>
                           <Font name="System Bold" size="20.0" />
                        </font>
                     </Label>

                     <Separator />

                     <HBox spacing="40.0" alignment="CENTER">
                        <VBox spacing="8.0" alignment="CENTER" styleClass="stat-box">
                           <padding>
                              <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                           </padding>
                           <Label text="Active Promotions" styleClass="stat-label">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label fx:id="activePromotionsLabel" text="0" styleClass="stat-value"
                                  textFill="#4caf50">
                              <font>
                                 <Font name="System Bold" size="32.0" />
                              </font>
                           </Label>
                        </VBox>

                        <VBox spacing="8.0" alignment="CENTER" styleClass="stat-box">
                           <padding>
                              <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                           </padding>
                           <Label text="Products on Sale" styleClass="stat-label">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label fx:id="productsOnSaleLabel" text="0" styleClass="stat-value"
                                  textFill="#ba68c8">
                              <font>
                                 <Font name="System Bold" size="32.0" />
                              </font>
                           </Label>
                        </VBox>

                        <VBox spacing="8.0" alignment="CENTER" styleClass="stat-box">
                           <padding>
                              <Insets bottom="20.0" left="30.0" right="30.0" top="20.0" />
                           </padding>
                           <Label text="Avg Discount" styleClass="stat-label">
                              <font>
                                 <Font size="14.0" />
                              </font>
                           </Label>
                           <Label fx:id="avgDiscountLabel" text="0%" styleClass="stat-value"
                                  textFill="#ff9800">
                              <font>
                                 <Font name="System Bold" size="32.0" />
                              </font>
                           </Label>
                        </VBox>
                     </HBox>
                  </VBox>

               </VBox>
            </content>
         </ScrollPane>

      </AnchorPane>
   </content>
</ScrollPane>
