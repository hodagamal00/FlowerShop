<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="il.cshaifasweng.OCSFMediatorExample.client.AdminControlController"
            stylesheets="@styles.css">

   <!-- Sticky Header -->
   <top>
      <HBox alignment="CENTER_LEFT" prefHeight="64.0" spacing="20.0"
            styleClass="app-navbar elevated">
         <children>
            <Label text="Admin Control Panel" styleClass="page-title"/>
            <HBox spacing="8.0" HBox.hgrow="ALWAYS"/>
            <Button fx:id="changeDetailsButton" text="Change Details"
                    styleClass="pill" visible="false"/>
            <Button fx:id="backButton" onAction="#openCatalog" text="← Back to Catalog"
                    styleClass="secondary pill"/>
         </children>
         <padding><Insets left="20.0" right="20.0"/></padding>
      </HBox>
   </top>

   <!-- Scrollable center -->
   <center>
      <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" pannable="true"
                  styleClass="app-scroll-container">
         <content>
            <VBox alignment="TOP_CENTER" spacing="20.0">
               <!-- Two-column admin layout -->
               <HBox spacing="20.0" maxWidth="1200.0">
                  <!-- Left: Accounts -->
                  <VBox spacing="14.0" prefWidth="360.0" styleClass="card hover-lift">
                     <children>
                        <Label text="User Accounts" styleClass="section-title">
                           <font><Font name="System Bold" size="20.0"/></font>
                        </Label>

                        <ComboBox fx:id="profileType" promptText="Select Account Type"
                                  onAction="#selectType"/>

                        <HBox spacing="8.0" alignment="CENTER_LEFT">
                           <children>
                              <TextField fx:id="searchField" promptText="Search by ID, name, or email"
                                         HBox.hgrow="ALWAYS"/>
                              <Button fx:id="searchButton" text="Search" onAction="#handleSearch"
                                      styleClass="secondary pill"/>
                           </children>
                        </HBox>

                        <TableView fx:id="usersTable" prefHeight="520.0">
                           <columns>
                              <TableColumn fx:id="userIdCol" text="User ID" prefWidth="80.0"/>
                              <TableColumn fx:id="userNameCol" text="Name" prefWidth="140.0"/>
                              <TableColumn fx:id="userEmailCol" text="Email" prefWidth="160.0"/>
                              <TableColumn fx:id="userRoleCol" text="Role" prefWidth="110.0"/>
                              <TableColumn fx:id="userPrivilegeCol" text="Privilege" prefWidth="80.0"/>
                              <TableColumn fx:id="userStatusCol" text="Status" prefWidth="90.0"/>
                           </columns>
                        </TableView>

                        <Button fx:id="loadProfile" text="Load Selected Account"
                                onAction="#loadSelectProfile" styleClass="pill"/>
                     </children>
                     <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                  </VBox>

                  <!-- Right: Account Details -->
                  <VBox spacing="16.0" prefWidth="800.0" styleClass="card hover-lift">
                     <children>
                        <Label text="Account Information" styleClass="section-title">
                           <font><Font name="System Bold" size="22.0"/></font>
                        </Label>

                        <!-- Three-column form grid -->
                        <GridPane hgap="18.0" vgap="12.0">
                           <columnConstraints>
                              <ColumnConstraints percentWidth="33"/>
                              <ColumnConstraints percentWidth="33"/>
                              <ColumnConstraints percentWidth="33"/>
                           </columnConstraints>

                           <!-- Column 1: Basic -->
                           <children>
                              <VBox spacing="10.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                 <children>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Account ID:"/>
                                          <TextField fx:id="accID" editable="false"
                                                     promptText="Auto"
                                                     styleClass="field-readonly"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Customer ID:"/>
                                          <TextField fx:id="customerID" promptText="e.g., 123456789"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Full Name:"/>
                                          <TextField fx:id="name" promptText="Full name"/>
                                       </children>
                                    </HBox>
                                    <VBox spacing="6.0">
                                       <children>
                                          <Text text="Address:"/>
                                          <!-- TextArea fits multi-line better than a tall TextField -->
                                          <TextArea fx:id="address" prefRowCount="3"
                                                    promptText="Street, City, Zip"/>
                                       </children>
                                    </VBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Email:"/>
                                          <TextField fx:id="email" promptText="name@example.com"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Password:"/>
                                          <TextField fx:id="password" promptText="••••••••"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Phone:"/>
                                          <TextField fx:id="phone" promptText="+972 5X-XXXXXXX"/>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- Column 2: Payment -->
                              <VBox spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                                 <children>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Credit Card #:"/>
                                          <TextField fx:id="creditnum" promptText="#### #### #### ####"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Expiry Month:"/>
                                          <TextField fx:id="creditexpmonth" promptText="MM"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Expiry Year:"/>
                                          <TextField fx:id="creditexpyear" promptText="YYYY"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="CVV:"/>
                                          <TextField fx:id="cvv" promptText="3 digits"/>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>

                              <!-- Column 3: Status -->
                              <VBox spacing="10.0" GridPane.columnIndex="2" GridPane.rowIndex="0">
                                 <children>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Logged In:"/>
                                          <TextField fx:id="logged" promptText="true / false"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Frozen:"/>
                                          <CheckBox fx:id="frozenToggle" text="Freeze account"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Shop ID:"/>
                                          <TextField fx:id="shop" promptText="Shop id"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Subscription:"/>
                                          <TextField fx:id="sub" editable="false"
                                                     promptText="—"
                                                     styleClass="field-readonly"/>
                                       </children>
                                    </HBox>
                                    <HBox spacing="8.0" alignment="CENTER_LEFT">
                                       <children>
                                          <Text text="Privilege Level:"/>
                                          <TextField fx:id="privilageField" promptText="0..3"/>
                                       </children>
                                    </HBox>
                                 </children>
                              </VBox>
                           </children>
                        </GridPane>

                        <!-- Actions -->
                        <HBox alignment="CENTER" spacing="12.0">
                           <children>
                              <Button fx:id="Save" text="Save Changes" onAction="#SaveChanges"
                                      styleClass="pill"/>
                              <Button fx:id="refreshButton" text="Refresh List"
                                      onAction="#handleRefresh" styleClass="secondary pill"/>
                           </children>
                        </HBox>

                        <Label fx:id="statusMessage" text="Status message" visible="false" styleClass="text-secondary">
                           <font><Font size="14.0"/></font>
                        </Label>

                        <!-- Loading indicator -->
                        <Label fx:id="wait" text="Please wait…" visible="false" styleClass="text-secondary">
                           <font><Font size="16.0"/></font>
                        </Label>
                     </children>
                     <padding><Insets top="18.0" right="18.0" bottom="18.0" left="18.0"/></padding>
                  </VBox>
               </HBox>

               <Region prefHeight="20.0"/>
            </VBox>
         </content>
      </ScrollPane>
   </center>

   <!-- Subtle footer line (optional) -->
   <bottom>
      <HBox alignment="CENTER" prefHeight="12.0" styleClass="app-footer"/>
   </bottom>
</BorderPane>
